# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/

# Data
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# Jupyter
**/.ipynb_checkpoints/

# Environments
.env
.venv/
env/

# Local temp (Drive mounts may not support tempfile probes)
.tmp/
output/

# Generated reports/artifacts
reports/**
!reports/
!reports/**/
!reports/**/.gitkeep

# Local Git recovery backups
.git.bak-*/
.git.partial-*/

# Binary docs (keep out of VCS by default)
*.pdf
*.docx
*.xlsx

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
